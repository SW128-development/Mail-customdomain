# Cloudflare Integration Configuration
# Create your API token at: https://dash.cloudflare.com/profile/api-tokens
# Required permissions: Zone:Read, Zone:Edit, Workers:Edit, D1:Edit
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# JWT Token for Cloudflare Worker Authentication
# This should match the JWT_TOKEN in your wrangler.toml if you have an existing worker
# If deploying a new worker, you can leave this empty to auto-generate
# For existing workers deployed with wrangler.toml, use: tusiKCfuyXrwDPrsP77GHZtSSdMux6AqDZQKmySpBss=
CLOUDFLARE_JWT_TOKEN=tusiKCfuyXrwDPrsP77GHZtSSdMux6AqDZQKmySpBss=

# Optional: Default values for new worker deployments
# These can be overridden in the UI during setup
# CLOUDFLARE_DEFAULT_WORKER_NAME=duckmail-worker
# CLOUDFLARE_DEFAULT_D1_NAME=temp_mail_db

# Application Settings
# NODE_ENV=production
# NEXT_PUBLIC_API_URL=http://localhost:3000

# Database (if using local database)
# DATABASE_URL=postgresql://user:password@localhost:5432/duckmail

# Email Provider Settings (optional)
# RESEND_API_KEY=your_resend_api_key_here
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password 